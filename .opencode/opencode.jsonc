{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:context7.key}",
        },
      },
      "sequential-thinking": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking",
        ],
        "timeout": {
          "startup": 60000,
          "catalog": 60000,
        },
      },
      "playwright": {
        "type": "local",
        "disabled": false,
        "command": ["node", "./node_modules/@playwright/mcp/cli.js", "--headless"],
        "cwd": ".",
        "timeout": {
          "startup": 60000,
          "catalog": 60000,
        },
      },
    },
  },
}
